SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me
# Private backend-only PostgreSQL login; never expose it to browser/client roles.
# It must bypass forced RLS (BYPASSRLS, or the local postgres superuser) and have
# SELECT/INSERT/UPDATE/DELETE on brands, provider_keys, provider_key_idempotency,
# brand_asset_operations, brand_kits, and generations. Vault access is limited to schema USAGE,
# create_secret EXECUTE, decrypted id/value SELECT, and secret id SELECT/DELETE.
DATABASE_URL=
# Optional heartbeat path; defaults to the OS temp directory.
# GENERATION_WORKER_HEARTBEAT=/tmp/postforge-worker-heartbeat
